{
  "manifest_version": 3,
  "name": "Eazy-share",
  "version": "1.0.0",
  "description": "Start a local file-sharing server and send files or folders to other devices on your Wi-Fi.",
  "key": "",
  "action": {
    "default_title": "Eazy-share",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["nativeMessaging"]
}
